# ── 鉴权（http 模式）────────────────────────────────────────────
# 强烈建议设置：不设的话，任何能访问该端口的人都能用你的头条号发内容。
# 变量名与 xiaohongshu-mcp 一致，飞燕的容器配置可直接复用。
AUTH_TOKEN=

# ── 监听 ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=18070

# ── 数据与浏览器 ───────────────────────────────────────────────
# 浏览器 profile（登录态）、截图、临时文件。容器里是 /app/data
TOUTIAO_DATA_DIR=./data
# false = 有头模式（本机调试 / 手动过验证码时用；容器里没有图形环境）
TOUTIAO_HEADLESS=true
# 换指纹浏览器或系统 Chrome
# TOUTIAO_BROWSER_PATH=
# http(s):// 或 socks5://
# TOUTIAO_PROXY=
# builtin（默认）| extra（需自行安装 playwright-extra 与 stealth 插件）| off
TOUTIAO_STEALTH=builtin
# 人类化节奏（随机停顿 + 逐字输入）。**生产别关** —— 关掉只用于测试与调试
TOUTIAO_HUMANIZE=true

# ── 发布行为 ───────────────────────────────────────────────────
# 正文插图策略：auto（推荐）| paste-url | intercept-upload | editor-upload
TOUTIAO_IMAGE_STRATEGY=auto
# 空闲多久关掉浏览器省内存（等扫码期间不受影响）
TOUTIAO_IDLE_TIMEOUT_MS=600000
# 同一账号的操作必须串行；排队超过这个数直接返回 BUSY
TOUTIAO_QUEUE_MAX=4
# 后台等扫码的上限
TOUTIAO_LOGIN_WAIT_MS=300000
# 单次工具调用的总预算
TOUTIAO_TOOL_TIMEOUT_MS=600000

# ── 日志 ───────────────────────────────────────────────────────
# debug | info | warn | error（日志一律写 stderr，stdout 是 MCP 协议通道）
LOG_LEVEL=info
